# Provider mode: "local" (default, 100% free compute) or "original" (hackathon backends)
PROVIDER=local

# ── Gemini Free Tier (API) ─────────────────────────────────────────────────
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# ── Ollama Local Lane ──────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ── Local Embeddings ───────────────────────────────────────────────────────
LOCAL_EMBED_MODEL=all-MiniLM-L6-v2

# ── Cost sensitivity parameter (λ) for quality-vs-cost tradeoff ────────────
COST_WEIGHT=0.0

# ── Original Hackathon Backends (only used if PROVIDER=original) ───────────
DASHSCOPE_API_KEY=
SIE_API_KEY=
